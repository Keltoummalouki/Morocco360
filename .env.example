# Application
PORT=
API_URL=
FRONTEND_URL=
NODE_ENV=

# Base URL the browser reaches the API on (used for the social sign-in redirects).
# Leave as-is for local dev; set to the public API domain in production.
API_PUBLIC_URL=http://localhost:4000

# Supabase Storage (server-only in the Next.js app)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=event-images

# Database Configuration
# Production (Supabase Session pooler, port 5432)
DATABASE_URL=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=false

# Local Docker fallback (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USER=morocco360
DB_PASS=morocco360
DB_NAME=morocco360

# JWT Configuration 
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# QR Code Security
QR_HMAC_SECRET=

# Social Sign-in (Optional — leave a pair blank to hide that button)
# Google:   https://console.cloud.google.com/apis/credentials
#           Authorised redirect URI: {API_PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps → Facebook Login → Settings
#           Valid OAuth Redirect URI: {API_PUBLIC_URL}/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Configuration (Optional)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-email@example.com
MAIL_PASS=your-email-password
MAIL_FROM=noreply@morocco360.com
